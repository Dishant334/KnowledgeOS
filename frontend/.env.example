# Copy this file to ".env" (git-ignored) and fill it in. Restart `npm run dev` after changing it.

# Where the backend API runs.
VITE_API_URL=http://localhost:8000

# Your Clerk PUBLISHABLE key (starts with pk_test_ or pk_live_): Clerk dashboard -> API keys.
# It is designed to be shipped to browsers, so it is not a secret; never put the SECRET key (sk_...) here.
VITE_CLERK_PUBLISHABLE_KEY=
