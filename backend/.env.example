# KnowledgeOS backend environment — copy to backend/.env and fill in.
# Settings (app/core/config.py) reads ".env" relative to the CURRENT DIRECTORY,
# so run uvicorn / alembic / celery from backend/. Names are case-insensitive.

# ---------------------------------------------------------------------------
# Core — REQUIRED (app fails at import if missing)
# ---------------------------------------------------------------------------
# Plain postgresql:// scheme required: app/generation/memory.py passes this
# straight to psycopg3, which rejects "+driver" suffixes.
# Host port 5433 matches docker-compose.yml ("5433:5432").
DATABASE_URL=postgresql://knowledgeos:change-me@localhost:5433/knowledgeos
QDRANT_URL=http://localhost:6333
# Qdrant collection for chunks (optional; tests use knowledgeos_test_chunks)
QDRANT_COLLECTION=documents
# Celery broker + result backend (optional; this is the default)
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Clerk — REQUIRED by Settings (Clerk Dashboard → API Keys / Webhooks)
# ---------------------------------------------------------------------------
# JWKS + issuer = your instance's Frontend API URL (no trailing slash on issuer).
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# OPTIONAL. Dashboard → Webhooks → your endpoint → Signing Secret.
# Empty = POST /webhooks/clerk returns 503 (users are still provisioned on first
# authenticated request; the webhook adds email/name and handles deletion).
CLERK_WEBHOOK_SECRET=whsec_replace_me
# OPTIONAL. Comma-separated allow-list for the JWT `azp` claim (frontend origins).
# Empty = not enforced. Recommended once a frontend exists.
CLERK_AUTHORIZED_PARTIES=
# OPTIONAL. Not used by backend code yet
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ---------------------------------------------------------------------------
# docker-compose interpolation (compose reads this same backend/.env)
# ---------------------------------------------------------------------------
POSTGRES_USER=knowledgeos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knowledgeos

# ---------------------------------------------------------------------------
# LLM (app/generation/llm.py). Empty LLM_PROVIDER = no LLM: /ask returns 503.
# ---------------------------------------------------------------------------
# Local first (development), cloud as the fallback:
#   ollama = model running on your own machine (Qwen3 8B); free, private, offline
#   gemini = Google's hosted model; free tier, works from any host (deployable at no cost)
LLM_PROVIDER=ollama
# Used automatically if the primary fails (Ollama not running, timeout, ...).
# PRIVACY: a fallback to Gemini sends the retrieved document text to Google, and the
# free tier may use prompts to improve their products. Leave empty to keep documents local.
LLM_FALLBACK_PROVIDER=gemini
#
# DEPLOYED server without Ollama:   LLM_PROVIDER=gemini   and   LLM_FALLBACK_PROVIDER=  (empty)

# Free key from https://aistudio.google.com/apikey  (never commit it)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash   # older models get retired: if you see 404, pick another from the models list

# Local model: install Ollama, then `ollama pull qwen3:8b`
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Not yet read by app code
# ---------------------------------------------------------------------------
# QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Optional — read by libraries, not by app code
# ---------------------------------------------------------------------------
# Persistent model cache (~1.3 GB; read by app settings, relative to backend/).
# Without it, models go to the macOS temp dir, which gets purged.
FASTEMBED_CACHE_PATH=./.fastembed_cache
# HF_TOKEN=                                # higher Hugging Face download rate limits
# TESSDATA_PREFIX=/opt/homebrew/share/tessdata
UNSTRUCTURED_DISABLE_NOTICE=1

# ---------------------------------------------------------------------------
# Observability: LangSmith tracing (app/core/tracing.py). OFF by default.
# ---------------------------------------------------------------------------
# With tracing on, each /ask appears in LangSmith as a tree: retrieval (chunks + scores), rerank, the
# prompt, the LLM call (tokens, latency) and the answer. The app copies these settings into the process
# environment at start-up (app/core/config.py); that is required, LangChain does not read this file.
# PRIVACY: questions, retrieved passages and answers are uploaded to LangSmith's cloud. Use sample data,
# or set the HIDE flags to upload only the shape of each step.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledgeos
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# ---------------------------------------------------------------------------
# Rate limiting (app/core/rate_limit.py). Per user; the counters live in Redis (REDIS_URL above).
# ---------------------------------------------------------------------------
# /ask and /ask/stream share one budget. Over a limit the API answers 429 with a Retry-After header.
# If Redis is unreachable the limiter lets requests through (and logs a warning).
RATE_LIMIT_ENABLED=true
ASK_PER_MINUTE=10        # token bucket: a burst of this many questions, refilling steadily over a minute
ASK_PER_DAY=100          # per UTC day (also protects the small Gemini fallback quota)
UPLOAD_PER_HOUR=10       # token bucket: document uploads
