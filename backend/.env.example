# KnowledgeOS backend environment — copy to backend/.env and fill in.
# Settings (app/core/config.py) reads ".env" relative to the CURRENT DIRECTORY,
# so run uvicorn / alembic / celery from backend/. Names are case-insensitive.

# ---------------------------------------------------------------------------
# Core — REQUIRED (app fails at import if missing)
# ---------------------------------------------------------------------------
# Plain postgresql:// scheme required: app/generation/memory.py passes this
# straight to psycopg3, which rejects "+driver" suffixes.
# Host port 5433 matches docker-compose.yml ("5433:5432").
DATABASE_URL=postgresql://knowledgeos:change-me@localhost:5433/knowledgeos
QDRANT_URL=http://localhost:6333
# Qdrant collection for chunks (optional; tests use knowledgeos_test_chunks)
QDRANT_COLLECTION=documents
# Celery broker + result backend (optional; this is the default)
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Clerk — REQUIRED by Settings (Clerk Dashboard → API Keys / Webhooks)
# ---------------------------------------------------------------------------
# JWKS + issuer = your instance's Frontend API URL (no trailing slash on issuer).
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# OPTIONAL. Dashboard → Webhooks → your endpoint → Signing Secret.
# Empty = POST /webhooks/clerk returns 503 (users are still provisioned on first
# authenticated request; the webhook adds email/name and handles deletion).
CLERK_WEBHOOK_SECRET=whsec_replace_me
# OPTIONAL. Comma-separated allow-list for the JWT `azp` claim (frontend origins).
# Empty = not enforced. Recommended once a frontend exists.
CLERK_AUTHORIZED_PARTIES=
# OPTIONAL. Not used by backend code yet
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# ---------------------------------------------------------------------------
# docker-compose interpolation (compose reads this same backend/.env)
# ---------------------------------------------------------------------------
POSTGRES_USER=knowledgeos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=knowledgeos

# ---------------------------------------------------------------------------
# Not yet read by app code (to be wired in later stages)
# ---------------------------------------------------------------------------
# QDRANT_API_KEY=
# LLM provider — none implemented yet; e.g.:
# GOOGLE_API_KEY=                          # Gemini (langchain-google-genai)
# OLLAMA_BASE_URL=http://localhost:11434   # Qwen via Ollama

# ---------------------------------------------------------------------------
# Optional — read by libraries, not by app code
# ---------------------------------------------------------------------------
# Persistent model cache (~1.3 GB; read by app settings, relative to backend/).
# Without it, models go to the macOS temp dir, which gets purged.
FASTEMBED_CACHE_PATH=./.fastembed_cache
# HF_TOKEN=                                # higher Hugging Face download rate limits
# TESSDATA_PREFIX=/opt/homebrew/share/tessdata
UNSTRUCTURED_DISABLE_NOTICE=1
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=knowledgeos
